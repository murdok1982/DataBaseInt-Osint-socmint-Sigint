{
  "name": "osint-nexus-frontend",
  "version": "0.1.0",
  "private": true,
  "description": "OSINT Nexus — Dashboard (SPEC-05). Tipos derivados de contracts/openapi.yaml.",
  "scripts": {
    "dev": "next dev",
    "build": "node -r ./scripts/readlink-eisdir-preload.cjs ./node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "next lint",
    "gen:api": "openapi-typescript ../../contracts/openapi.yaml -o src/types/api.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@types/cytoscape": "^3.21.4",
    "@types/node": "^20.16.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.1.10",
    "cytoscape": "^3.30.2",
    "maplibre-gl": "^6.16.0",
    "next": "15.5.28",
    "react": "19.1.10",
    "react-dom": "19.1.10",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@vitest/coverage-v8": "4.1.12",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.28",
    "jsdom": "25.0.1",
    "openapi-typescript": "^7.4.1",
    "postcss": "8.5.31",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "postcss": "8.5.31"
  }
}
