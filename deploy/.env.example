# =====================================================================
# .env.example — Plantilla de credenciales y claves secretas
# Copiar a .env y rellenar. NUNCA versionar .env real (Constitución, Regla 4).
# Deriva de SPEC-04 (seguridad) y SPEC-02 §5 (worker Celery).
# =====================================================================

# --- General ---
PUBLIC_HOSTNAME=osint-nexus.example.com
ENVIRONMENT=production

# --- Base de datos de grafos (Neo4j) ---
# SPEC-04 §2: Neo4j vive en internal_intel_net y NUNCA publica puertos.
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_STRONG
# Imagen neo4j:5-enterprise (obligatoria: el contrato usa property-existence
# constraints, solo disponibles en Enterprise Edition, SPEC-01). La variable
# acepta la licencia en nombre del operador; sin ella el contenedor no arranca.
NEO4J_ACCEPT_LICENSE_AGREEMENT=yes

# --- PostgreSQL 16 + pgvector (SPEC v3.0.0, Hito 1) ---
# Capa 1 (ledger append-only) + capa 2 (grafo validado). Sin puerto público.
POSTGRES_DB=osint
POSTGRES_USER=osint_owner
POSTGRES_PASSWORD=CHANGE_ME_STRONG
# DSN que usa el backend (rol de mínimo privilegio en producción).
# En local puede apuntar al owner; en producción usa un rol svc_*.
POSTGRES_DSN=postgresql://osint_owner:CHANGE_ME_STRONG@postgres:5432/osint
# Feature flag de la migración: neo4j | postgres | dual
GRAPH_BACKEND=neo4j

# --- Redis (cola de jobs y broker Celery) ---
# SPEC-02 §5: estado/progreso del job en Redis; nunca publicado (Regla 4).
REDIS_URL=redis://redis:6379/0

# --- Worker Celery (SPEC-02 §5) ---
# Broker de la tarea osint.workers.ingest_report. Si se omite, el worker cae a
# REDIS_URL (app/workers/celery_app.py: CELERY_BROKER_URL → REDIS_URL).
CELERY_BROKER_URL=redis://redis:6379/0
# Nº de procesos concurrentes del worker (docker-compose.prod.yml).
WORKER_CONCURRENCY=2

# --- Seguridad / JWT (SPEC-04 §2 v2.2) ---
JWT_SECRET_KEY=CHANGE_ME_64_RANDOM_BYTES
JWT_ALGORITHM=HS256
# Topes normativos: el backend NO arranca con valores mayores (15 min / 7 días).
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536

# --- 2FA y fuerza bruta (SPEC-04 §2/§2.1) ---
# 2FA TOTP obligatorio para ADMIN. "false" solo se admite fuera de producción.
ADMIN_TOTP_REQUIRED=true
# 5 fallos en 15 min por (IP, usuario) => 429 + Retry-After.
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_SECONDS=900
# true solo detrás de Nginx (que fija X-Real-IP); afecta al bloqueo y a la bitácora.
TRUST_PROXY_HEADERS=true

# Secreto HMAC del preflight_token (Fase 0, SPEC-03 §5). Sin valor por defecto
# en producción: si falta, el servicio genera uno efímero por proceso (solo dev).
PREFLIGHT_SECRET=CHANGE_ME_PREFLIGHT_HMAC_SECRET

# --- Operadores humanos (sin credenciales por defecto, SPEC-04 §4) ---
# Genera el hash + fragmento JSON con: python deploy/scripts/init-admin-user.py --username admin
# La forma preferida es OSINT_USERS_JSON (lista); alternativa de un ADMIN:
# OSINT_ADMIN_USERNAME + OSINT_ADMIN_PASSWORD_HASH (ver app/core/users.py).
# OSINT_USERS_JSON=[{"id":"<uuid>","username":"admin","password_hash":"$argon2id$...","role":"ADMIN","totp_secret":"<base32>"}]
# OSINT_ADMIN_USERNAME=admin
# OSINT_ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$...
# OSINT_ADMIN_TOTP_SECRET=<base32 generado por init-admin-user.py>  (obligatorio para ADMIN)

# --- API Keys M2M AI_INFORMANT (SPEC-04 §5.2; sin credenciales por defecto) ---
# Genera la clave + hash con: python deploy/scripts/init-api-keys.py --client-name informant-agent
# OSINT_API_KEYS_JSON=[{"id":"<uuid>","client_name":"informant-agent","key_hash":"$argon2id$...","role":"AI_INFORMANT","revoked":false}]
# La misma clave en claro la usa el servicio informant-agent:
INFORMANT_API_KEY=CHANGE_ME_M2M_API_KEY
INFORMANT_API_BASE_URL=http://backend:8000
INFORMANT_SOURCE_DIR=/sources

# --- Almacenamiento de informes (volumen reports_data → /storage) ---
# SPEC-02 §1.2: informes crudos y chunks; solo el backend/worker acceden.
STORAGE_RAW_DIR=/storage/raw_reports
STORAGE_CHUNKS_DIR=/storage/processed_chunks
# Tope de subida de informes en MB (SPEC-02 §1.1). Por encima => 413. Nginx corta a 100 MB.
MAX_UPLOAD_MB=50

# --- LLM / Extracción NLP (SPEC-02) ---
LLM_PROVIDER=openai
LLM_API_KEY=CHANGE_ME
LLM_MODEL=gpt-4o-mini
EXTRACTION_CONFIDENCE_THRESHOLD=0.50

# --- Copias de seguridad (SPEC-06 §3; deploy/scripts/backup.sh y restore.sh) ---
# Directorio del host donde se guardan las copias CIFRADAS (fuera del repositorio).
BACKUP_DIR=/var/backups/osint-nexus
# Fichero (permisos 0600, fuera del repo) con la frase de cifrado AES-256 de GnuPG.
BACKUP_PASSPHRASE_FILE=/etc/osint-nexus/backup.passphrase
BACKUP_RETENTION_DAYS=30

# --- Smoke test (deploy/scripts/smoke-test.sh) — NO son secretos del servicio ---
# Credenciales del operador ADMIN creado con init-admin-user.py y la API Key M2M.
# SMOKE_BASE_URL=https://osint-nexus.example.com/api/v1
# SMOKE_USERNAME=admin
# SMOKE_PASSWORD=CHANGE_ME_SMOKE_PASSWORD
# SMOKE_API_KEY=CHANGE_ME_M2M_API_KEY
# SMOKE_TOTP_CODE=
# SMOKE_INSECURE=0    # 1 = curl -k (certs autofirmados en pruebas)
